<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      Only for builds without a Developer ID (ad-hoc signature, `identity: -`): the same
      entitlements as entitlements.mac.plist plus disable-library-validation. Ad-hoc code
      has no team ID, so under the hardened runtime library validation would refuse to
      load Electron's own framework and the app would not start. A Developer ID build
      signs every nested binary with one team and uses entitlements.mac.plist instead.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
